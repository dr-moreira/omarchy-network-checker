{
  "schemaVersion": 1,
  "id": "daniel.network-checker",
  "name": "Home servers",
  "version": "1.0.0",
  "author": "daniel",
  "license": "MIT",
  "description": "Home-lab ping and port status from network_checker on the Omarchy bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Home servers",
    "description": "Show which home servers are online and which ports are open.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 60,
      "command": ""
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 15,
        "max": 3600,
        "step": 15,
        "defaultValue": 60
      },
      {
        "key": "command",
        "type": "string",
        "label": "network_checker path",
        "defaultValue": ""
      }
    ]
  }
}
