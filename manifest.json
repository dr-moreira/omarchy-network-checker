{
  "schemaVersion": 1,
  "id": "io.github.dr-moreira.network-checker",
  "name": "Network Checker",
  "version": "1.0.0",
  "author": "Daniel Rangel",
  "license": "MIT",
  "description": "Ping and port status for home-lab servers on the Omarchy bar.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Network Checker",
    "description": "Show which configured hosts are online and which ports are open.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 60,
      "command": "",
      "configFile": ""
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 15,
        "max": 3600,
        "step": 15,
        "defaultValue": 60
      },
      {
        "key": "command",
        "type": "string",
        "label": "network_checker path",
        "defaultValue": ""
      },
      {
        "key": "configFile",
        "type": "string",
        "label": "Config TOML path",
        "defaultValue": ""
      }
    ]
  }
}
